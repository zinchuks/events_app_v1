{
  "name": "@event-radar/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ../../scripts/prepare-map-assets.mjs && expo start --dev-client",
    "web": "node ../../scripts/prepare-map-assets.mjs && expo start --web",
    "start:staging": "node ../../scripts/prepare-map-assets.mjs && APP_VARIANT=staging expo start --dev-client",
    "web:staging": "node ../../scripts/prepare-map-assets.mjs && APP_VARIANT=staging expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand --watch=false --watchman=false",
    "export": "node ../../scripts/prepare-map-assets.mjs && expo export --platform ios --platform android --platform web",
    "config": "expo config --type public",
    "doctor": "expo-doctor",
    "deps:check": "expo install --check"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.4.1",
    "@supabase/supabase-js": "2.117.2",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.22",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "maplibre-gl": "6.11.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.2",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.3.1",
    "uniwind": "^1.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.17",
    "expo-doctor": "1.20.4",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.16",
    "tailwindcss": "4.1.18",
    "typescript": "^5.9.3"
  }
}
