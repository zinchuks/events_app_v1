# Local shell works without accounts. This file contains no credentials.
APP_VARIANT=development
# Set your own UUID before EAS builds. Never use the upstream template project.
EAS_PROJECT_ID=
# Supabase public configuration will be consumed in S2, after RLS is implemented.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public per-platform RevenueCat SDK keys, not secret REST/webhook keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
