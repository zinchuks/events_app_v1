{
  "cli": { "version": ">=16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" },
      "ios": { "simulator": true }
    },
    "staging": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "staging" }
    }
  }
}
