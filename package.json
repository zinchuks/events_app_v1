{
  "name": "event-radar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "22.23.3",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @event-radar/mobile start",
    "dev:web": "pnpm --filter @event-radar/mobile web",
    "dev:admin": "pnpm --filter @event-radar/admin dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps scripts",
    "test": "pnpm --filter @event-radar/mobile test && node --test scripts/*.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:env && pnpm check:secrets",
    "check:env": "node scripts/check-env.mjs",
    "build:admin": "pnpm --filter @event-radar/admin build",
    "export:mobile": "pnpm --filter @event-radar/mobile export",
    "audit:deps": "pnpm audit --audit-level=high",
    "check:secrets": "node scripts/check-secrets.mjs",
    "local:env": "node scripts/configure-local.mjs",
    "test:s2": "node scripts/test-s2-integration.mjs",
    "check:client-bundles": "node scripts/check-client-bundles.mjs",
    "ingest:madrid:local": "node scripts/ingest-madrid-local.mjs",
    "test:s3": "node scripts/test-s3-integration.mjs",
    "notify:s3:fixture": "node scripts/dispatch-s3-local.mjs fixture",
    "notify:s3:expo": "node scripts/dispatch-s3-local.mjs expo",
    "notify:s3:receipts": "node scripts/dispatch-s3-local.mjs receipts",
    "test:s4": "node scripts/test-s4-integration.mjs",
    "test:s5": "node scripts/test-s5-integration.mjs",
    "ingest:s6:local": "node scripts/ingest-s6-local.mjs",
    "ingest:s6:watch": "node scripts/ingest-s6-local.mjs --watch",
    "test:s6": "node scripts/test-s6-integration.mjs",
    "test:s6:ai": "node scripts/test-s6-ai-concurrency.mjs",
    "ai:s6:status": "node scripts/check-s6-ai-local.mjs",
    "schedule:s7:local": "node scripts/schedule-s7-local.mjs",
    "schedule:s7:watch": "node scripts/schedule-s7-local.mjs --watch",
    "notify:s7:expo": "node scripts/schedule-s7-local.mjs --expo",
    "notify:s7:receipts": "node scripts/schedule-s7-local.mjs --receipts",
    "test:s7": "node scripts/test-s7-concurrency.mjs",
    "test:s7:api": "node scripts/test-s7-integration.mjs",
    "schedule:s8:local": "node scripts/schedule-s8-local.mjs",
    "schedule:s8:watch": "node scripts/schedule-s8-local.mjs --watch",
    "test:s8": "node scripts/test-s8-concurrency.mjs",
    "test:s8:api": "node scripts/test-s8-integration.mjs",
    "test:s9": "node scripts/test-s9-concurrency.mjs",
    "test:s9:api": "node scripts/test-s9-integration.mjs",
    "billing:s9:status": "node scripts/billing-s9-local.mjs status",
    "billing:s9:local": "node scripts/billing-s9-local.mjs run",
    "billing:s9:watch": "node scripts/billing-s9-local.mjs watch",
    "billing:s9:webhook": "node scripts/billing-s9-local.mjs webhook"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@supabase/supabase-js": "2.117.2",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "1.11.0",
      "tar": "7.5.22",
      "postcss": "8.5.28",
      "image-size": "2.0.3",
      "xcode>uuid": "11.1.1"
    },
    "patchedDependencies": {
      "metro@0.83.3": "patches/metro@0.83.3.patch"
    }
  }
}
